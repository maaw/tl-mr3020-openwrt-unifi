#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    /usr/bin/ucode -e 'import * as fs from "fs"; exit(json(fs.readfile("/etc/mr3020.json")).enabled === true ? 0 : 1);' || return 0
    mkdir -p /var/run/mr3020-adopt /etc/mr3020-state
    chmod 700 /var/run/mr3020-adopt /etc/mr3020-state
    chown 453:453 /var/run/mr3020-adopt
    local bootstrap
    /usr/bin/ucode -L /usr/lib/mr3020 -e 'import * as fs from "fs"; import { lock } from "account"; import { FACTORY_KEY } from "session"; let p=json(fs.readfile("/etc/mr3020.json")), s=json(fs.readfile("/etc/mr3020-state/state.json") || "null"), needed=p.allow_adoption === true && (s == null || s.key == FACTORY_KEY); lock("/etc/shadow", !needed); exit(needed ? 0 : 10);'
    bootstrap=$?
    [ "$bootstrap" -eq 0 ] || [ "$bootstrap" -eq 10 ] || return 1
    if [ "$bootstrap" -eq 0 ]; then
        [ -s /etc/dropbear/mr3020_adoption_rsa_key ] || /usr/bin/dropbearkey -t rsa -s 2048 -f /etc/dropbear/mr3020_adoption_rsa_key
        procd_open_instance adoption
        procd_set_param command /usr/sbin/dropbear -F -E -p 2222 -w -j -k -T 2 -I 30 -K 10 -r /etc/dropbear/mr3020_adoption_rsa_key -c '/usr/bin/ucode -L /usr/lib/mr3020 /usr/lib/mr3020/adopt-command.uc'
        procd_set_param respawn 3600 10 3
        procd_set_param oom_score_adj 500
        procd_close_instance
    fi
    procd_open_instance agent
    procd_set_param command /usr/bin/ucode -L /usr/lib/mr3020 /usr/lib/mr3020/start.uc
    procd_set_param respawn 3600 10 3
    procd_set_param oom_score_adj 500
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
