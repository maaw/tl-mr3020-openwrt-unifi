#!/bin/sh
# Sysupgrade restores this state before UCI defaults run. Keep the provisioned
# radio settings so the adopted AP continues serving clients after reboot.
[ ! -s /etc/mr3020-state/state.json ] || exit 0

# Keep management and recovery independent of UniFi or successful adoption.
uci -q set system.@system[0].hostname='mr3020'
uci -q commit system
# Use the platform's normal PHY detection, rather than guessing its bus path.
wifi config
if uci -q get wireless.radio0 >/dev/null; then
    uci -q set wireless.radio0.disabled='1'
    uci -q commit wireless
fi
exit 0
